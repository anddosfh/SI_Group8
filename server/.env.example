PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret

# Shared Neon database for the group: paste your project's connection string from the Neon console.
# Use sslmode=verify-full instead of Neon's default "sslmode=require&channel_binding=require" to avoid pg's SSL warning.
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Local PostgreSQL instead: role and database created by `npm run db:setup` (src/database/setup.sql)
DATABASE_URL=postgres://nova:nova_local_dev@localhost:5432/nova_gadgets

# Lab 2: product transfer from the Mini-ERP (defaults match its local `cds watch` setup)
ERP_URL=http://localhost:4004
ERP_USER=service-user
ERP_PASSWORD=service-user
# Export from the ERP every N minutes; 0 = only with "Pull from ERP now" in the admin dashboard.
# With a shared database, enable this on one machine only (each member's ERP has its own in-memory data).
ERP_SYNC_INTERVAL_MINUTES=0
# How often server/data/erp-transfer/inbox is checked for new files (0 = never automatically)
ERP_INBOX_POLL_SECONDS=30
# ERP_TRANSFER_DIR=C:\path\to\erp-transfer   (default: server/data/erp-transfer)
